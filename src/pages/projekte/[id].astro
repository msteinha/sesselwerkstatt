---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categories } from '../../content.config';
import { getProjects, absolute, breadcrumbJsonLd } from '../../lib/site';
import { getImage } from 'astro:assets';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project, projects } }));
}) satisfies GetStaticPaths;

const { project, projects } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Projekte', href: '/projekte/' },
  { name: data.title, href: `/projekte/${project.id}/` },
];
const related = projects.filter((p) => p.id !== project.id && p.data.category === data.category).slice(0, 3);
const coverOg = await getImage({ src: data.cover, width: 1200, format: 'jpeg' });

const creativeWork = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  image: absolute(coverOg.src, Astro.site),
  genre: categories[data.category],
  dateCreated: data.date.toISOString().slice(0, 10),
  creator: { '@id': absolute('/#business', Astro.site) },
  url: absolute(`/projekte/${project.id}/`, Astro.site),
};
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  imageAlt={data.coverAlt}
  ogType="article"
  jsonLd={[creativeWork, breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <article class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="project-head">
        <div>
          <p class="meta">{categories[data.category]}</p>
          <h1>{data.title}</h1>
          <p class="lead">{data.summary}</p>
          <div class="prose"><Content /></div>
          <a class="button" href={`/kontakt/?projekt=${encodeURIComponent(data.title)}`}>Anfrage zu diesem Stück</a>
        </div>
        {
          data.before && data.after ? (
            <BeforeAfter
              before={data.before}
              after={data.after}
              beforeAlt={data.beforeAlt ?? `${data.title} – vorher`}
              afterAlt={data.afterAlt ?? `${data.title} – nachher`}
              caption="Vorher / Nachher – Regler ziehen"
            />
          ) : (
            <Picture
              class="cover"
              src={data.cover}
              alt={data.coverAlt}
              widths={[480, 800, 1100]}
              sizes="(min-width: 56rem) 34rem, 100vw"
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </div>

      {
        data.images.length > 0 && (
          <section class="more-images" aria-labelledby="bilder">
            <h2 id="bilder">Weitere Bilder</h2>
            <Gallery images={data.before ? [{ src: data.cover, alt: data.coverAlt }, ...data.images] : data.images} />
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="aehnlich">
            <h2 id="aehnlich">Weitere Projekte: {categories[data.category]}</h2>
            <ul class="card-grid">
              {related.map((p) => (
                <li>
                  <ProjectCard project={p} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .project-head {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 56rem) {
    .project-head {
      grid-template-columns: 1fr 1fr;
    }
  }

  .meta {
    margin: 0 0 0.3rem;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red-light);
  }

  .project-head :global(.cover) {
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .lead {
    margin-inline: 0;
  }

  .more-images,
  .related {
    margin-top: 3.5rem;
  }
</style>
