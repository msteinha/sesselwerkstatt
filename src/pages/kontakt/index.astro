---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';
import portrait from '../../assets/site/herbert-steinhauser.jpg';
---

<BaseLayout
  title="Kontakt"
  description="Sie haben Interesse an einem Sessel oder möchten einen Sessel restaurieren lassen? Schreiben Sie der Sesselwerkstatt in Horn eine Nachricht."
>
  <section class="section">
    <div class="container">
      <header class="center">
        <h1>Schreiben Sie mir</h1>
        <p class="lead">Sie haben Interesse an einem Sessel, oder möchten einen Sessel restaurieren lassen? Senden Sie mir eine Nachricht.</p>
      </header>

      <div class="contact">
        <Image src={portrait} alt="Herbert Steinhauser bei einer Bergwanderung" widths={[400, 700]} sizes="(min-width: 48rem) 30rem, 100vw" format="webp" loading="lazy" />

        <form id="formular" action="/api/kontakt" method="POST" accept-charset="UTF-8">
          <p class="error" role="alert" hidden></p>
          <input type="hidden" name="t" value="" />
          <input type="hidden" name="projekt" value="" />
          <div class="honeypot" aria-hidden="true">
            <label for="website">Bitte leer lassen</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" maxlength="200" required />

          <label for="email">E-Mail-Adresse</label>
          <input type="email" id="email" name="email" autocomplete="email" required />

          <label for="message">Nachricht</label>
          <textarea id="message" name="message" rows="7" maxlength="5000" required></textarea>

          <div class="consent">
            <input type="checkbox" id="privacy" name="privacy" required />
            <label for="privacy">
              Ich stimme der <a href="/datenschutz/" target="_blank">Datenschutzerklärung</a> zu.
            </label>
          </div>

          <button type="submit">Senden</button>

          <p class="alt">
            Oder direkt per E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#formular')!;
  const params = new URLSearchParams(location.search);

  // Zeitstempel für den Spam-Schutz (zu schnelles Absenden = Bot).
  form.querySelector<HTMLInputElement>('input[name=t]')!.value = String(Date.now());

  // Vorbelegung, wenn man von einer Projektseite kommt (?projekt=...).
  const projekt = params.get('projekt');
  const message = form.querySelector<HTMLTextAreaElement>('#message')!;
  if (projekt) {
    form.querySelector<HTMLInputElement>('input[name=projekt]')!.value = projekt;
    if (!message.value) message.value = `Anfrage zum Projekt „${projekt}“:\n\n`;
  }

  const errors: Record<string, string> = {
    eingabe: 'Bitte füllen Sie alle Felder aus und stimmen Sie der Datenschutzerklärung zu.',
    versand: 'Die Nachricht konnte leider nicht gesendet werden. Bitte versuchen Sie es später noch einmal oder schreiben Sie direkt eine E-Mail.',
  };
  const error = params.get('fehler');
  if (error) {
    const box = form.querySelector<HTMLElement>('.error')!;
    box.textContent = errors[error] ?? errors.versand;
    box.hidden = false;
  }

  form.addEventListener('submit', () => {
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    button.disabled = true;
    button.textContent = 'Wird gesendet …';
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
    align-items: stretch;
  }

  @media (min-width: 48rem) {
    .contact {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact :global(img) {
    width: 100%;
    height: 100%;
    max-height: 40rem;
    object-fit: cover;
    border-radius: var(--radius);
  }

  form {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--red);
    color: var(--cream);
    border-radius: var(--radius);
  }

  label {
    margin: 1rem 0 0.3rem;
    font-weight: 700;
    font-size: 0.95rem;
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    padding: 0.8rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--cream);
    color: var(--red);
    font: inherit;
  }

  .consent {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .consent label {
    margin: 0;
    font-weight: 400;
  }

  .consent input {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--red-light);
  }

  button {
    margin-top: 1.5rem;
    padding: 0.9rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--red-light);
    color: #fff;
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }

  button:hover {
    filter: brightness(1.1);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  .error {
    margin: 0 0 0.5rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    background: var(--cream);
    color: var(--red);
    font-weight: 700;
  }

  button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .alt {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }
</style>
