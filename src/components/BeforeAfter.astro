---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption?: string;
}

const { before, after, beforeAlt, afterAlt, caption } = Astro.props;
const widths = [480, 900];
const sizes = '(min-width: 34rem) 30rem, 100vw';
---

<figure class="ba-figure">
  <div class="ba-slider" style={`--pos: 50%; aspect-ratio: ${after.width} / ${after.height};`}>
    <Image class="ba-before" src={before} alt={beforeAlt} widths={widths} sizes={sizes} format="webp" loading="lazy" draggable="false" />
    <Image class="ba-after" src={after} alt={afterAlt} widths={widths} sizes={sizes} format="webp" loading="lazy" draggable="false" />
    <span class="ba-label ba-label-before">Vorher</span>
    <span class="ba-label ba-label-after">Nachher</span>
    <div class="ba-handle" aria-hidden="true"></div>
    <input
      type="range"
      class="ba-range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label={`${caption ?? 'Vorher-Nachher-Vergleich'} – Schieberegler`}
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Jeder Schieberegler steuert die CSS-Variable --pos seines Sliders.
  document.querySelectorAll<HTMLInputElement>('.ba-range').forEach((range) => {
    const slider = range.closest<HTMLElement>('.ba-slider')!;
    const update = () => slider.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .ba-figure {
    margin: 0 auto;
    width: 100%;
    max-width: 30rem;
  }

  .ba-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    user-select: none;
    touch-action: pan-y;
    background-color: var(--red);
  }

  .ba-slider :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* "Nachher" liegt oben und wird rechts vom Griff sichtbar. */
  .ba-slider :global(.ba-after) {
    clip-path: inset(0 0 0 var(--pos));
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: #fff;
    transform: translateX(-1px);
    pointer-events: none;
    box-shadow: 0 0 4px rgb(0 0 0 / 0.5);
  }

  .ba-handle::after {
    content: '\2194';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: #fff;
    color: var(--red);
    font-size: 1.1rem;
    line-height: 2.2rem;
    text-align: center;
    box-shadow: 0 0 6px rgb(0 0 0 / 0.4);
  }

  /* Unsichtbarer Range-Input über dem ganzen Bild fängt Maus, Touch und Tastatur ab. */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: ew-resize;
  }

  .ba-range:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .ba-range::-webkit-slider-thumb {
    appearance: none;
    width: 2.4rem;
    height: 100%;
    cursor: ew-resize;
  }

  .ba-range::-moz-range-thumb {
    width: 2.4rem;
    height: 100%;
    border: none;
    background: transparent;
    cursor: ew-resize;
  }

  .ba-label {
    position: absolute;
    bottom: 10px;
    padding: 3px 10px;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    border-radius: 3px;
    pointer-events: none;
  }

  .ba-label-before {
    left: 10px;
  }

  .ba-label-after {
    right: 10px;
  }

  figcaption {
    margin-top: 0.75rem;
    text-align: center;
  }
</style>
