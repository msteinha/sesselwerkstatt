---
import { Image } from 'astro:assets';
import logo from '../assets/site/logo.png';

const links = [
  { href: '/projekte/', label: 'Projekte' },
  { href: '/leistungen/', label: 'Leistungen' },
  { href: '/kontakt/', label: 'Kontakt' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <nav class="container" aria-label="Hauptnavigation">
    <a href="/" class="brand" aria-label="Sesselwerkstatt – Startseite">
      <Image src={logo} alt="" height={48} loading="eager" />
      <span>Sesselwerkstatt</span>
    </a>
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--cream);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 1.15rem;
  }

  .brand img {
    width: auto;
    height: 48px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    display: inline-block;
    padding-block: 0.4rem;
    font-size: 1.15rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  ul a:hover,
  ul a[aria-current='page'] {
    border-bottom-color: currentColor;
  }
</style>
